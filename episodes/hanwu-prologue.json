      "subtitle": [],
      "shot_ids": [
        "shot-004"
      ]
    },
    {
      "id": "frame-002",
      "text": "他将四十年的战火，烧向北方的大漠。",
      "narration_text": "他将四十年的战火，烧向北方的大漠。",
      "audio_path": "D:/hv/episodes/hanwu-prologue/audio/frame-002.wav",
