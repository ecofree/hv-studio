        "shot-003"
      ]
    },
    {
      "id": "frame-001-02",
      "text": "正策动一场改变世界的远征。",
      "narration_text": "正策动一场改变世界的远征。",
      "audio_path": "D:/hv/episodes/hanwu-prologue/audio/frame-001-02.wav",
