      ]
    },
    {
      "id": "frame-001-01",
      "text": "一个年轻的皇帝，",
      "narration_text": "一个年轻的皇帝，",
      "audio_path": "D:/hv/episodes/hanwu-prologue/audio/frame-001-01.wav",
