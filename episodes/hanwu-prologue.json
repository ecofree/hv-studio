      "subtitle": [],
      "shot_ids": [
        "shot-005"
      ]
    },
    {
      "id": "frame-003",
      "text": "他让一条路，从长安一直铺到罗马。",
      "narration_text": "他让一条路，从长安一直铺到罗马。",
