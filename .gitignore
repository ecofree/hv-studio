# ---- 密钥 / 本地环境 ----
.env
*.env
.env.local
.env.*.local
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ---- 大体积生成产物（不入库；本地生产） ----
episodes/*/audio/
episodes/*/build/
episodes/*/out/
episodes/*/shots/
episodes/hanwu_15min/*.mp4
# 但保留 episode 模型 json
!episodes/*.json
# 清理暂存区（本仓可回收的僵尸/备份）
.trash_hv/

# ---- 运行时产物目录（不入库；内容由本地生产/下载） ----
# cache/ 与 assets/ 下各子目录（bgm/characters/fonts/scenes/sfx）目前为空占位，
# 将来若放入 BGM/字体等第三方素材同样不应入库。
cache/
assets/
logs/
# cosyvoice3/probe_v35.py 是真实探针脚本（已入库，保留）；只忽略其输出目录。
cosyvoice3/probe_out/

# ---- 运行时状态 ----
state/
.tmp/
*.tmp
*.log
.pytest_cache/

# ---- 测试产物（一次性 smoke episode） ----
episodes/smoke-*/
episodes/smoke-*.json

# ---- Agent/实验瞬态（不入库） ----
.workbuddy/
.cache/
