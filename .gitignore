# ---- 密钥 / 本地环境 ----
.env
*.env
.env.local
.env.*.local
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
.venv-asr/
.venv-core/
venv/
*.egg-info/

# ---- 大体积生成产物（不入库；本地生产） ----
episodes/*/audio/
episodes/*/build/
episodes/*/out/
episodes/*/shots/
episodes/*/production/
episodes/hanwu_15min/*.mp4
# ⚠️ `audio/` 上面的规则只挡**正好叫 audio 的目录**，带后缀的兄弟目录
# （audio_qwen旧策略/、audio_旧旁白_20260928/ 这类失败重试与音色对比残留）
# 不在规则内 —— 2026-10-10 实测：lishimin-01 的两个 audio_* 目录磁盘上共
# 22.8GB，`git add -A` 会把其中 552 个文件（128MB）拉进暂存区。
episodes/*/audio_*/
episodes/*/audio-*/
# 但保留 episode 模型 json
!episodes/*.json
# 编排锁：运行期互斥用的临时文件，进程退出即失效，入库只会制造假冲突
episodes/*/.produce.lock
# 人工审听记录：属于人工决定的留痕，与成片一起入库
!episodes/*/分镜审听_*.md
# ⚠️ 以下三类**要入库**，它们是作者输入的源，不是生成产物（AGENTS.md
#    "Preserve source narration"）。列在这里只为防误加宽泛规则把它们扫掉：
#      episodes/*/script.md          解说脚本原文（唯一真源）
#      episodes/*/scene_plan.json    声明式分镜
#      episodes/*/image_prompts.json 生图提示词
#    同目录下其余（audio/ build/ out/ shots/ production/）已在上面排除。
# 清理暂存区（本仓可回收的僵尸/备份）
.trash_hv/

# ---- 运行时产物目录（不入库；内容由本地生产/下载） ----
# cache/ 与 assets/ 下各子目录（bgm/characters/fonts/scenes/sfx）目前为空占位，
# 将来若放入 BGM/字体等第三方素材同样不应入库。
cache/
assets/
logs/
# 音色试听探针产物（_voicetone 是一次性比对用，不入库）
episodes/_voicetone/
# cosyvoice3/probe_v35.py 是真实探针脚本（已入库，保留）；只忽略其输出目录。
cosyvoice3/probe_out/

# ---- 运行时状态 ----
state/
.tmp/
*.tmp
*.log
.pytest_cache/

# ---- 测试产物（一次性 smoke episode） ----
episodes/smoke-*/
episodes/smoke-*.json

# ---- Agent/实验瞬态（不入库） ----
.workbuddy/
.cache/

# ---- 外部音频接入（大文件，不入库）----
resource/external_audio/

# ---- 工具二进制与本地渲染音轨（2026-10-10 推送前实测）----
# tools/ffmpeg/bin/*.exe 三个各 158~161MB，**超 GitHub 单文件 100MB 硬限**，
# push 必然被拒。ffmpeg 由 `bin/setup_local_asr.ps1` / PATH 安装，不入库。
tools/ffmpeg/
# Gemini TTS 渲染出的解说音轨（整集 ~40-50MB ×4 集 + 分幕 wav，合计约 250MB）。
# 入库的「作者输入源」是 scripts/*.md（剧本与 TTS 专稿）；音轨是**渲染产物**，
# 与成片同属「Git 之外单独备份」的一类（见 docs/production_runbook.md 末节）。
resource/风趣历史.writing-DNA/scripts/audio/
# 音色试听探针产物（与 episodes/_voicetone/ 同类：一次性比对用，不入库）
resource/风趣历史.writing-DNA/scripts/test_*.wav
# Independent studio working data and copy/verification evidence.
/workspace/
/.copy-setup/
