# ============================================================
# 环境变量模板 —— 复制为 .env 后填写真实密钥。
# ⚠️ .env 已被 .gitignore 排除，禁止提交版本库。
# 本文件只保留【空占位】；任何行都不允许出现真实密钥值。
# ============================================================

# --- 生图（第三方中转 subrouter.ai，三份独立配额） ---
# 命名约定 {provider}_gpt-image-2。示例文件一律留空。
aicost_gpt-image-2=
qcyc_gpt-image-2=
cxk_gpt-image-2=

# 中转地址（OpenAI 兼容协议；非机密，公开可填）
gpt-image-2_API_BASE=https://subrouter.ai

# --- 可选：中转特殊鉴权头（默认 Bearer，一般无需改） ---
# OPENAI_API_AUTH_HEADER=Authorization
# OPENAI_API_EXTRA_HEADERS={}

# --- 生图参数（可被 config 覆盖） ---
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1792
IMAGE_QUALITY=high

# --- 旁白 TTS：DashScope CosyVoice v3.5（voice design） ---
# 需在百炼控制台申请 voice design；命名 vapi_cosyvoice-v2 / DASHSCOPE_API_KEY
vapi_cosyvoice-v2=
DASHSCOPE_WORKSPACE=
DASHSCOPE_API_KEY=
# COSYVOICE_V35_MODEL=
# COSYVOICE_V35_RESPONSE_FORMAT=mp3
# COSYVOICE_V35_SAMPLE_RATE=24000
